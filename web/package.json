  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:layout": "node bench/run-layout-probe.mjs",
    "test:e2e": "playwright test",
