{
  "name": "puppet-master-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "build:terminal": "node terminal-web/build.mjs",
    "check": "pnpm run build:terminal && tsc --noEmit -p tsconfig.json && tsc --noEmit -p terminal-web/tsconfig.json",
    "test": "vitest run"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./plugins",
      "ios": {
        "exclude": ["expo-file-system"]
      }
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@puppet-master/client-core": "workspace:*",
    "expo": "~56.0.24",
    "expo-build-properties": "~56.0.27",
    "expo-dev-client": "~56.0.28",
    "expo-device": "~56.0.4",
    "expo-notifications": "~56.0.26",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-marked": "^8.2.0",
    "react-native-svg": "^15.15.5",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "babel-preset-expo": "~56.0.21",
    "esbuild": "^0.28.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}
