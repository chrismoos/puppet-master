# Copy to /etc/puppet-master/pushgw.env (root:pushgw, mode 0640).
# The .p8 itself is a secret and belongs only on the server.

PUSHGW_APNS_KEY_P8=/etc/puppet-master/apns-key.p8
PUSHGW_APNS_KEY_ID=XXXXXXXXXX
PUSHGW_APNS_TEAM_ID=YYYYYYYYYY

# Only needed when the key above is scoped to production alone, which
# APNs reports as BadEnvironmentKeyInToken on sandbox pushes. Left
# unset, the key above signs both environments. Set both or neither.
#PUSHGW_APNS_SANDBOX_KEY_P8=/etc/puppet-master/apns-sandbox-key.p8
#PUSHGW_APNS_SANDBOX_KEY_ID=ZZZZZZZZZZ
PUSHGW_APNS_TOPIC=com.example.app

# Caddy proxies to this address. Keep it on loopback: the relay
# authenticates nothing.
PUSHGW_LISTEN=127.0.0.1:8400

# The Caddy on this host. Without it every sender shares one source
# rate limit, because each request arrives from the proxy's address.
PUSHGW_TRUSTED_PROXIES=127.0.0.1

# Rate limits and the block on a source sending invalid device tokens.
# These are the defaults.
#PUSHGW_RATE_PER_SOURCE=60
#PUSHGW_RATE_PER_TOKEN=30
#PUSHGW_RATE_WINDOW_SECS=60
#PUSHGW_BAD_TOKEN_LIMIT=5
#PUSHGW_BAD_TOKEN_WINDOW_SECS=60
#PUSHGW_BAD_TOKEN_BLOCK_SECS=600
